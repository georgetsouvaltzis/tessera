<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md"/>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE"/>
        <None Include="..\..\site\static\img\tessera-nuget-icon.png" Pack="true" PackagePath="\" Link="tessera-nuget-icon.png"/>
    </ItemGroup>

    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PackageId>Tessera</PackageId>
        <Title>Tessera</Title>
        <Description>C#-first terminal UI framework for .NET. Build dashboards, workflows, and multi-pane workbenches with a message-driven app model, rich widgets, and theme-first styling.</Description>
        <Authors>George Tsouvaltzis</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageTags>tui;terminal-ui;console-ui;csharp;dotnet;ansi;widgets;dashboard;workbench</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>tessera-nuget-icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/georgetsouvaltzis/tessera</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/georgetsouvaltzis/tessera</PackageProjectUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

</Project>
