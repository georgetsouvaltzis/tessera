<Project>
  <PropertyGroup>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and '$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'">
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.23.0.137933" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Scoped unsafe allowlist for interop-heavy projects that require source-generated P/Invoke. -->
    <TesseraUnsafeAllowlistedProject Condition="'$(MSBuildProjectName)' == 'Tessera.Core'">true</TesseraUnsafeAllowlistedProject>
    <TesseraUnsafeAllowlistedProject Condition="'$(MSBuildProjectName)' == 'Tessera.Benchmarks'">true</TesseraUnsafeAllowlistedProject>
    <TesseraUnsafeAllowlistedProject Condition="'$(MSBuildProjectName)' == 'BenchmarkDotNet.Autogenerated'">true</TesseraUnsafeAllowlistedProject>
  </PropertyGroup>

  <Target Name="EnforceNoUnsafeBlocks" BeforeTargets="CoreCompile">
    <Error Condition="'$(AllowUnsafeBlocks)' == 'true' and '$(TesseraAllowUnsafe)' != 'true' and '$(TesseraUnsafeAllowlistedProject)' != 'true'" Text="Tessera forbids unsafe code. Remove /unsafe or set TesseraAllowUnsafe=true only for approved benchmark/test projects." />
  </Target>
</Project>
